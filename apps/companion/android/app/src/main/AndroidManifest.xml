<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required at runtime, not just for dev tooling: this app talks to the
         Talon bridge over HTTP+SSE. Flutter's debug/profile manifests merge
         this in automatically for hot reload/VM service, but the release
         manifest (what actually ships) needs its own explicit grant, or
         every socket connect fails at the OS level with errno=1
         "Operation not permitted": easy to mistake for the unrelated
         cleartext traffic or macOS sandbox errno=1 failures, since Android
         produces the identical error text for "no INTERNET permission" as
         it does for those. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Voice mode: on-device speech recognition needs the mic (runtime
         prompt, requested the first time voice mode is opened). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- The mesh foreground service now OWNS the bridge connection (SSE) and
         answers exec/file-transfer commands — that's dataSync work, declared
         as such for Android 14+'s typed-foreground-service enforcement. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Optional app lock: fingerprint / face unlock through BiometricPrompt
         (never required — the passcode always works). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Device control (teleport substrate): reach shared storage (Downloads,
         DCIM, …) so remote exec/filesystem commands can operate on the user's
         files. MANAGE_EXTERNAL_STORAGE (All files access) is granted manually
         in system settings; the legacy READ/WRITE grants cover pre-Android-11. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <!-- Shizuku (optional elevated privilege): when the Shizuku app is running
         and grants permission, exec commands run at shell (ADB) UID. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23"/>
    <!-- Self-update: hand a downloaded release APK to Android's package
         installer when neither root nor Shizuku is available for a silent
         `pm install`. The user still grants "install unknown apps" for Talon
         and taps Install on the system dialog — this permission only lets the
         app ask. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Opt in to Android 13+ predictive back so the system back gesture
         animates properly and Flutter's PopScope (chat → chat list) can
         participate instead of the gesture killing the activity. -->
    <!-- Custom Application: hooks the foreground-task engine's creation to
         register the talon/shizuku channel there too (see TalonApplication) —
         backgrounded/boot-restarted exec keeps Shizuku elevation. -->
    <!-- Nothing the app stores is worth restoring — a restored or migrated
         phone simply pairs again — while what it stores (the bridge token,
         an imported client certificate and its password, recent chats) must
         not end up in a cloud backup or on another device. allowBackup and
         fullBackupContent cover Android 11 and older; dataExtractionRules
         covers cloud backup and device-to-device transfer on Android 12+. -->
    <application android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="Talon"
        android:name=".TalonApplication"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Digital-assistant candidacy: an activity handling ASSIST is
                 what makes Talon selectable under Settings → Default apps →
                 Digital assistant app, and what the long-press-home / corner
                 gesture launches once selected. MainActivity is singleTop, so
                 a warm assist launch arrives as onNewIntent and the app jumps
                 straight into voice mode (see VoiceBridge). -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!-- Pairing deep link: the daemon's `/mesh link` hands the phone a
                 page whose button is talon://pair?u=…&t=…&f=…, carrying the
                 bridge URL, bearer token and certificate fingerprint so the
                 connection configures itself. BROWSABLE is what lets the
                 browser (and Telegram's in-app browser) hand it over. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="talon" android:host="pair"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- TEMPORARY: Impeller's Vulkan backend crash-loops on the Pixel 10
             Android 17 beta (driver rejects the BackdropFilter snapshot
             texture with VK_ERROR_COMPRESSION_EXHAUSTED_EXT → fatal
             back_texture check in canvas.cc). Fall back to Skia until the
             engine/driver fix ships, then delete this.
             See https://github.com/jameskokoska/Cashew/pull/1242 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <!-- stopWithTask=false: swiping the app from recents must NOT stop the
             mesh — the service keeps running (and the plugin's onTaskRemoved
             restart alarm re-arms it if the OS kills the process anyway). -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="dataSync|location"
            android:stopWithTask="false"
            android:exported="false" />
        <!-- Serves two directories: the self-updater's download folder (to
             the package installer) and the chat-attachment cache (to the app
             that opens a tapped file). A raw file:// URI throws
             FileUriExposedException on Android 7+, so the content:// URI plus
             a per-intent read grant is the only working handoff. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/talon_update_paths" />
        </provider>
        <!-- Shizuku binder provider — required for the Shizuku client to bind.
             Harmless when the Shizuku app is not installed. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Voice mode: package-visibility grants for the on-device speech
             recognition and TTS engine services (Android 11+ filters them
             out otherwise, making SpeechRecognizer.isRecognitionAvailable
             return false even when Google's recognizer is installed). -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
